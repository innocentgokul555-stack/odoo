# Copy this file to ".env" ONLY if you want to change something. Everything has a working default.
PORT=4000
# Change this to a long random text before using the system for real:
JWT_SECRET=change-me-to-a-long-random-text
# Where the database file is stored:
# DB_PATH=./data/odoo.db
# Shows password-reset links on screen (no email server needed). Set to false in real production:
DEMO_MODE=true
# Used inside emailed links (the address where the website is opened):
APP_URL=http://localhost:5173
COMPANY_NAME=Brightloop Software
CURRENCY=USD
# Daily automatic billing check (true/false) and whether new invoices are confirmed automatically:
BILLING_AUTORUN=true
BILLING_AUTO_CONFIRM=false
# Optional: send real emails (leave empty to only keep them in the in-app outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Brightloop Billing <billing@brightloop.test>
